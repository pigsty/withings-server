{
  "name": "withings-server",
  "version": "1.0.0",
  "description": "Withings HTTP API compatible scale callback server",
  "license": "MIT",
  "author": "Chris Birkinshaw",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:ui": "vite --config ui/vite.config.js",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.js",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/server.js",
    "test:e2e": "node --test test/e2e.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "svelte": "^5.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.14"
  }
}